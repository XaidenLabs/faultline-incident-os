# Only required for live model runs. Credential-free replay and tests do not use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1

# Persistent autonomous incident queue.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
FAULTLINE_AGENT_KEY=replace-with-a-private-worker-key
# Supabase Edge Function secret for the optional external incident endpoint.
# Never expose this value in browser code.
FAULTLINE_INGEST_TOKEN=replace-with-a-long-random-token

# Browser-safe configuration for Live Pulse Realtime subscriptions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Set OPENAI_API_KEY and OPENAI_MODEL as Supabase Edge Function secrets
# to enable model-enriched live triage. Capture continues without them.
